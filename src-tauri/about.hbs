<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Hakushi — Rust dependency licenses</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 62rem; margin: 2rem auto; padding: 0 1rem; }
      h2 { border-bottom: 1px solid #ddd; padding-bottom: .25rem; }
      pre { white-space: pre-wrap; background: #f6f8fa; padding: 1rem; overflow: auto; border-radius: 6px; }
      ul { columns: 2; }
    </style>
  </head>
  <body>
    <h1>Hakushi — Rust dependency licenses</h1>
    <p>Generated by <code>cargo about</code>. See <code>THIRD_PARTY_LICENSES.md</code> for the full inventory and manual attributions.</p>
    {{#each licenses}}
    <h2>{{name}}</h2>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li>{{crate.name}} {{crate.version}}</li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
    {{/each}}
  </body>
</html>
